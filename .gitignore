# Claude Code local state - session data, worktrees, task locks, scheduled runs.
# Whole directory excluded; nothing under .claude/ should ever be pushed.
.claude/
tools/**/*.lic
*.lic
ComplianceScan_Output/
CISScan_Output/
CMMCScan_Output/
NIST171Scan_Output/
HardenedGPO_Output/
reports/
*.log
*.tmp

# Heavy VT enrichment caches — keep local only, never commit
output-baseline/VirusTotal-main/
output-baseline/VirusTotal-behaviors/
output-baseline/Cert_Analysis_Results/
output-baseline/IntezerStrings/

# Heavy per-APT raw event maps — keep local only, summaries are committed
apt/**/Targeted_Analysis_Map.csv

# KAPE offline staging — Kroll's kape.exe / gkape.exe are NOT redistributable
# (KAPE EULA: "licensed, not sold"; no copy/redistribute/transfer). Stage a
# complete KAPE folder locally with tools/deploy/Get-KAPE-Offline.ps1; it rides
# to the air-gapped VM on disk (a filesystem copy — gitignore does not block that)
# and 1b deploys it. It must never enter git history on this public repo.
tools/kape
tools/KAPE
tools/kape.zip
tools/KAPE.zip

# Offline dependency staging (tools/deps/Get-Dependencies-Offline.ps1) + the tools
# it distributes. Redistributable but heavy/machine-specific: staged locally, carried
# to the air-gapped VM on disk, never committed. The helper script + README stay tracked.
tools/deps/*
!tools/deps/Get-Dependencies-Offline.ps1
!tools/deps/README.md
tools/uac
tools/UAC
tools/uac.tar.gz
tools/uac.tgz
tools/uac.zip
tools/dfir-orc
tools/dfir-orc.zip
tools/loki
codeScanning/yara64.exe
codeScanning/scorecard.exe
/NSRL
